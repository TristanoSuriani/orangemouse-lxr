diff --git a/Core/Src/Preset/presetManager.c b/Core/Src/Preset/presetManager.c
index 41ef096..ecd0fe9 100644
--- a/Core/Src/Preset/presetManager.c
+++ b/Core/Src/Preset/presetManager.c
@@ -51,7 +51,6 @@ char currentFolder[13];
 #define FILE_VERSION 2
 
 /*
-#define NUM_TRACKS 7
 #define NUM_PATTERN 8*/
 #define STEPS_PER_PATTERN NUM_STEPS //64
 
@@ -84,6 +83,36 @@ uint32_t preset_patTimer = 0;
 uint8_t preset_kitDirty = 0;
 uint8_t preset_patDirty = 0;
 
+// The VA slots' sound of each kit in RAM (mainParameters holds the drum voices');
+// written after the drum parameters in every kit file.
+#define VA_KIT_BYTES (VA_NUM_SLOTS * VA_NUM_PARAMS)
+static uint8_t va_kitParameters[NUM_KIT_SLOTS][VA_KIT_BYTES];
+
+// a kit's VA block, with the default sounds if it has none yet
+static uint8_t *preset_vaKit(uint8_t presetNr)
+{
+	uint8_t *p = va_kitParameters[presetNr];
+	for (int i = 0; i < VA_KIT_BYTES; i++)
+		if (p[i])
+			return p;
+	va_initKitParameters(p);
+	return p;
+}
+
+// reads the VA block of a kit file; defaults if the file has none
+static void preset_readVaData(uint8_t *dst)
+{
+	unsigned int bytesRead = 0;
+	if (f_read((FIL*)&SDFile, dst, VA_KIT_BYTES, &bytesRead) != FR_OK || bytesRead != VA_KIT_BYTES)
+		va_initKitParameters(dst);
+}
+
+static void preset_vaKitToActive(uint8_t presetNr)
